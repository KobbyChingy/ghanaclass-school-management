# Copy to scripts/msix.release.env and fill in your production values.
# This file is ignored by git so certificate secrets stay local.

MSIX_DISPLAY_NAME=GhanaClass School Management
MSIX_PUBLISHER_DISPLAY_NAME=Your Company Name
MSIX_IDENTITY_NAME=YourCompany.GhanaClassSchoolManagement
MSIX_PUBLISHER=CN=Your Company Name
MSIX_VERSION=1.0.13.0
MSIX_LOGO_PATH=windows/runner/resources/app_icon.ico
MSIX_CERTIFICATE_PATH=windows/msix/your-production-signing-certificate.pfx
MSIX_CERTIFICATE_PASSWORD=replace-with-your-certificate-password
MSIX_CAPABILITIES=internetClient